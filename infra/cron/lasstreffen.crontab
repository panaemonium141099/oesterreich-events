# infra/cron/lasstreffen.crontab — Ersatz fuer die 12 `crons` aus vercel.json
#
# Installation:
#   cp infra/cron/lasstreffen.crontab /etc/cron.d/lasstreffen
#   chown root:root /etc/cron.d/lasstreffen && chmod 644 /etc/cron.d/lasstreffen
#   systemctl restart cron
#
# WICHTIG — Zeitzone:
# Vercel fuehrt Crons in UTC aus. Damit sich die Zeitpunkte beim Umzug NICHT
# verschieben (Oesterreich ist UTC+2 im Sommer, UTC+1 im Winter), laeuft diese
# Tabelle explizit in UTC. Wer die Zeiten auf Lokalzeit umstellen will, macht
# das als eigene, bewusste Aenderung — nicht als Nebeneffekt der Migration.
CRON_TZ=UTC
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# CRON_SECRET wird aus /etc/lasstreffen/cron.env gelesen (chmod 600, root).
# Die Routes pruefen exakt `Authorization: Bearer ${CRON_SECRET}` — identisch
# zu dem, was Vercel automatisch gesetzt hat. Siehe z.B.
# src/app/api/cron/expire-boosts/route.ts.
#
# run-cron.sh kapselt: Secret laden, curl mit Timeout+Retry, Exit-Code und
# Antwort nach /var/log/lasstreffen/cron-<name>.log, Alert bei Fehlschlag.

# ── Zeitplaene 1:1 aus vercel.json uebernommen ──────────────────────────────
# min  hour dom mon dow  user  command

# 0 8 * * *      — taegliche Event-Reminder
0    8    *   *   *    root  /opt/lasstreffen/infra/scripts/run-cron.sh send-reminders

# 0 6 * * *      — GSC/CrUX-Snapshot (Collector ist deadline-begrenzt)
0    6    *   *   *    root  /opt/lasstreffen/infra/scripts/run-cron.sh seo-daily-snapshot

# 0 * * * *      — Cache-Warming (zieht bundesland=X&limit=3000-Payloads)
0    *    *   *   *    root  /opt/lasstreffen/infra/scripts/run-cron.sh warm-cache

# 15 * * * *     — Feratel-Sync
15   *    *   *   *    root  /opt/lasstreffen/infra/scripts/run-cron.sh sync-feratel

# 0 15 * * 4     — Lifecycle-Mails, donnerstags
0    15   *   *   4    root  /opt/lasstreffen/infra/scripts/run-cron.sh lifecycle-emails

# ── B2B-Outreach-Funnel ─────────────────────────────────────────────────────
# 0 4 * * *
0    4    *   *   *    root  /opt/lasstreffen/infra/scripts/run-cron.sh outreach-cold
# 30 4 * * *
30   4    *   *   *    root  /opt/lasstreffen/infra/scripts/run-cron.sh outreach-discover
# 0 5 * * *
0    5    *   *   *    root  /opt/lasstreffen/infra/scripts/run-cron.sh outreach-enrich
# 30 5 * * *
30   5    *   *   *    root  /opt/lasstreffen/infra/scripts/run-cron.sh outreach-draft
# 0 6 * * 1      — Outreach-Monitoring, montags
0    6    *   *   1    root  /opt/lasstreffen/infra/scripts/run-cron.sh outreach-monitor

# ── Sonstige ────────────────────────────────────────────────────────────────
# 0 1 * * *      — abgelaufene Boosts deaktivieren
0    1    *   *   *    root  /opt/lasstreffen/infra/scripts/run-cron.sh expire-boosts

# 0 6 * * 5      — Wochen-Newsletter, freitags
0    6    *   *   5    root  /opt/lasstreffen/infra/scripts/run-cron.sh newsletter-weekly

# ── Betrieb ─────────────────────────────────────────────────────────────────
# Taegliches Offsite-Backup, 02:30 UTC (vor dem Scrape-Fenster 03:17).
30   2    *   *   *    root  /opt/lasstreffen/infra/scripts/backup.sh

# ── NICHT hier eingeplant ───────────────────────────────────────────────────
# /api/cron/eventim  — der Eventim-Import laeuft als GitHub-Actions-Workflow
#   (import-eventim.yml, alle 6 h). Die Route existiert, war aber auch in
#   vercel.json nicht eingeplant. Nicht "reparieren", ohne vorher zu pruefen,
#   ob damit zwei Importer parallel laufen.
#
# /api/cron/seo-content-refresh, /api/cron/seo-traffic-alert,
# /api/cron/seo-weekly-report — diese drei Routes existieren, waren aber in
#   vercel.json NICHT eingeplant (fuer seo-content-refresh in MASTERPLAN §3.3
#   bereits vermerkt). Der Umzug uebernimmt den Ist-Zustand unveraendert:
#   was auf Vercel nicht lief, laeuft auch hier nicht. Ob sie eingeplant
#   werden sollen, ist eine Produktentscheidung, keine Migrationsfrage.
