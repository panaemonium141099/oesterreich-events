# Mapbox (for map tiles and static map thumbnails)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxx

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# GitHub (for admin scraper panel — GitHub Actions trigger)
GITHUB_TOKEN=ghp_xxx
GITHUB_REPO=owner/repo

# Scraper API — protects /api/scrape and /api/admin routes
SCRAPE_API_KEY=change-me-in-production

# Analytics — salt for hashing visitor IPs (privacy-preserving)
ANALYTICS_SALT=change-me-in-production

# Web-Push / VAPID (desktop notifications). Generate with:
#   npx web-push generate-vapid-keys --json
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must equal VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@glatzdev.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# GetYourGuide-Affiliate (fn-22) — Touren-Boxen auf Event-, Gemeinde-,
# Aktivitaets- und Blogseiten. Ohne diese Werte rendert die Box NICHTS.
# Werden zur Laufzeit gelesen (kein Rebuild noetig, env_file reicht).
NEXT_PUBLIC_GYG_ENABLED=false
NEXT_PUBLIC_GYG_PARTNER_ID=
# Optional: Name des Kampagnen-Parameters, Default "cmp".
# NEXT_PUBLIC_GYG_CAMPAIGN_PARAM=cmp

# Signiert Bestaetigungs- und Abmelde-Links (Event-Erinnerungen, Newsletter).
# PFLICHT, sobald E-Mails versendet werden: ohne diesen Wert laeuft die
# HMAC-Signatur auf einen leeren Schluessel und jede Anmeldung endet mit
# einem Fehler. Beliebiger langer Zufallswert, z. B. `openssl rand -hex 32`.
# Aendern macht bereits verschickte Links ungueltig.
UNSUBSCRIBE_SECRET=
