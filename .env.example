# Mapbox (for map tiles and static map thumbnails)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxx

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# GitHub (for admin scraper panel — GitHub Actions trigger)
GITHUB_TOKEN=ghp_xxx
GITHUB_REPO=owner/repo

# Scraper API — protects /api/scrape and /api/admin routes
SCRAPE_API_KEY=change-me-in-production

# Analytics — salt for hashing visitor IPs (privacy-preserving)
ANALYTICS_SALT=change-me-in-production

# Google Analytics 4 (Measurement-ID, e.g. G-XXXXXXXXXX). Leave empty in
# dev / preview to suppress the gtag.js load entirely (no network call).
# Loaded via next/script strategy="afterInteractive" so it never blocks
# first paint.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Web-Push / VAPID (desktop notifications). Generate with:
#   npx web-push generate-vapid-keys --json
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must equal VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@glatzdev.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
