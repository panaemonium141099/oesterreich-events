# Mapbox (for map tiles and static map thumbnails)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxx

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# GitHub (for admin scraper panel — GitHub Actions trigger)
GITHUB_TOKEN=ghp_xxx
GITHUB_REPO=owner/repo

# Scraper API — protects /api/scrape and /api/admin routes
SCRAPE_API_KEY=change-me-in-production

# Analytics — salt for hashing visitor IPs (privacy-preserving)
ANALYTICS_SALT=change-me-in-production
