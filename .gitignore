# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# fn-15.6 — prebuild artifact (sha256 of CRITICAL_CSS for CSP header).
# Must NOT be committed: a stale checked-in hash would defeat the
# prebuild safeguard. next.config.ts re-computes from src/lib/critical-css.ts
# anyway and only falls back to this JSON if source is unreadable.
.csp-hash.json

# typescript
*.tsbuildinfo
next-env.d.ts

# archive (stale research, planning, completed flow tasks)
/archive/

# database
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# scraper progress & migration files
data/scraper-progress-*.json
data/migration-batch-*.json

# Python dev artifacts (blog generator scripts - not part of app)
*.py
__pycache__/
blog-posts-brauchtum/
data/archive/*.json.gz
data/archive/stats-*.json
data/AT.txt
data/AT.zip

# Scrape reports
reports/
# Added by code-review-graph
.code-review-graph/

# Local tooling & session state
.claude/settings.local.json
.flow/.checkpoint-*.json
.superpowers/
supabase/.temp/

# Runtime backfill state
.backfill-cursor.txt
data/coord-backup-*.json

# Scratch notes
Bericht*.txt

# Vercel CLI local link
.vercel

# Overpass venue dump (regeneratable, 100MB+)
data/overpass-venues.json
data/overpass-cache/

# Other generated data dumps
data/events-dump*.json
data/events-dump*.jsonl
data/enrich*.jsonl
data/category-classifier-needsreview-checkpoint.json
data/classifier-audit/
data/tourism-fix-backup-*.jsonl
data/coord-backup-*-2026-*.json

# Audit exports — generated locally for gegenkontrolle, not source
data/exports/
.cache/
.claude/sessions/

# Claude worktrees — disposable per-session git clones, never check in.
# Including them as embedded git repos (gitlinks, mode 160000) breaks
# every other clone of this repo. Happened once on 5e5ed78 (2026-05-29).
.claude/worktrees/

# Generic checkpoint files — local script state, not source.
data/*-checkpoint.json

# Email preview artefacts — generated by scripts/preview-emails.mjs.
tmp/
