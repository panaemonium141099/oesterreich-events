     "ratings": [],
     "media_objects": [
      {
       "rel": "default",
       "url": "https://dam.destination.one/1136544/83be0a6b1d9e006a4030eb00936ff69ffa71168e22d5e021b8f559c6bf5691b1/der-meyerhof-des-heimatmuseum-schee-el.png",
       "type": "image/png",
       "author": "info@heimatverein-scheessel.de",
       "source": "Heimatverein \"Niedersachsen\" e.V. Scheeßel",
       "latitude": 53.1696206744694,
       "longitude": 9.47883009910583,
       "description": "Es ist anzunehmen, dass der denkmalgeschützte Meyerhof der älteste der ehemaligen sechs Vollhöfe in Scheeßel ist. Er wurde zum ersten Mal im Jahr 1320 urkundlich erwähnt.",
       "focusX": 0.03,
       "focusY": 0.16,
       "license": "CC-BY-SA",
       "copyrightWeb": "https://www.heimatverein-scheessel.de/",
       "width": 1920,
       "height": 1080,
       "alt": "Der Meyerhof des Heimatmuseum Scheeßel",
       "value": "Der Meyerhof des Heimatmuseum Scheeßel"
      },
      {
       "rel": "imagegallery",
       "url": "https://dam.destination.one/1136541/7d99a39230c3f8a9f43efa4cb9290d3f9ff472bdd3aa7a30848bc3988f8c90cb/das-heimathaus-des-heimatmuseums-schee-el.png",
       "type": "image/png",
       "author": "info@heimatverein-scheessel.de",
       "source": "Heimatverein \"Niedersachsen\" e.V. Scheeßel",
       "latitude": 53.1695549,
       "longitude": 9.4776699,
       "description": "Das Heimathaus ist das zweite Gebäude-Ensemble des Heimatmuseums. Das dreischiffige Hallenhaus mit Mitteldiele, beidseitigen Viehställen und Viehboxen, entstand um 1830.<br><br>",
       "focusX": 0.04,
       "focusY": -0.19,
       "license": "CC-BY-SA",
       "copyrightWeb": "https://www.heimatverein-scheessel.de/",
       "width": 1920,
       "height": 1080,
       "alt": "Das Heimathaus des Heimatmuseums Scheeßel",
       "value": "Das Heimathaus des Heimatmuseums Scheeßel"
      },
      {
       "rel": "imagegallery",
       "url": "https://dam.destination.one/1136542/8880b8b7b9670859e0056ecdd7acfea50e006c3708316bab8f32440950d5b014/honigspeicher-und-schafstall-des-heimatmuseum-schee-el.png",
       "type": "image/png",
       "author": "info@heimatverein-scheessel.de",
       "source": "Heimatverein \"Niedersachsen\" e.V. Scheeßel",
       "latitude": 53.1722222222222,
       "longitude": 9.47777777777778,
       "description": "Dieser Honigspeicher wurde um 1850 erbaut und wird als Ausstellungs- und Sitzungsraum verwendet<p></p><p>Der ebenerdige Raum im Erdgeschoss ist Ausstellungs- und Vorführraum zum Thema Imkerei. Der Bodenraum wurde ausgebaut und dient als Sitzungszimmer und Regieraum bei Veranstaltungen auf dem Gelände.</p><p>Der ehemalige Schafstall befand sich in der Feldmark von Groß Meckelsen im Landkreis Rotenburg und wurde ab 1968 hier wiederaufgebaut.Schafstall&nbsp; Tanz- und Trachtengruppe „De Beekscheepers“ sollte darin einen Übungsraum auf dem Heimat-hausgelände bekommen.</p><p>Am 23. August 1969 konnte der Schafstall eingeweiht und der Tanz- und Trachtengruppe „De Beekscheepers“ feierlich übergeben werden.</p>",
       "focusX": -0.23,
       "focusY": -0.04,
       "license": "CC-BY-SA",
       "copyrightWeb": "https://www.heimatverein-scheessel.de/",
       "width": 1920,
       "height": 1080,
       "alt": "Honigspeicher und Schafstall des Heimatmuseum Scheeßel",
       "value": "Honigspeicher und Schafstall des Heimatmuseum Scheeßel"
      },
      {
       "rel": "imagegallery",
       "url": "https://dam.destination.one/1136549/caea0cf49c65eb1e6aad98a0b646d1cf6995601c6cee208d8a38d0bf63b97845/museumsdag-und-markt-an-de-beek.png",
       "type": "image/png",
       "author": "info@heimatverein-scheessel.de",
       "source": "Heimatverein \"Niedersachsen\" e.V. Scheeßel",
